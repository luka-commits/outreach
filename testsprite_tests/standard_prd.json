{
  "meta": {
    "project": "Outbound Pilot",
    "date": "2025-12-30",
    "prepared_by": "Software Development Manager"
  },
  "product_overview": "Outbound Pilot is a sales outreach application designed to help agencies, freelancers, and sales teams manage leads and execute multi-channel outreach campaigns at scale. Users can integrate Gmail and Twilio for email and voice outreach, automate lead scraping, and manage subscriptions.",
  "core_goals": [
    "Enable users to efficiently manage and organize thousands of leads for outbound sales campaigns.",
    "Provide seamless integration with Gmail and Twilio for email and voice outreach capabilities.",
    "Automate lead generation through scraping pipelines and AI-powered business information extraction.",
    "Ensure security and privacy with encrypted credential storage and strict user isolation.",
    "Support subscription billing and access control via Stripe integration.",
    "Offer reliability and scalability for hundreds of users and thousands of leads.",
    "Implement rate limiting to prevent abuse and maintain service quality."
  ],
  "key_features": [
    "Lead scraping jobs with start, cancel, and webhook status update endpoints.",
    "Gmail OAuth integration allowing users to securely connect their email accounts for sending and token refresh.",
    "Twilio multi-step verification and credential saving for outbound calling and call status/webhook management.",
    "Sending emails to leads using either Gmail or Resend services with rate limiting and error handling.",
    "AI-driven web scraping of business information from company URLs with monthly and per-minute limits for free users.",
    "Stripe webhook integration for subscription and billing event handling.",
    "Twilio voice webhooks for call handling, call recordings, and real-time call status updates.",
    "Secure endpoints requiring authenticated JWT tokens, with role-based access and user job ownership verification.",
    "Encrypted storage of sensitive credentials like Twilio keys and Resend API keys.",
    "Robust webhook signature validation for incoming call and payment webhooks.",
    "Frontend built with React, TypeScript, Vite, and TanStack Query for performant user experience."
  ],
  "user_flow_summary": [
    "User signs in via Supabase Auth and sets up integrations by connecting Gmail via OAuth and submitting Twilio credentials.",
    "User creates and starts a lead scraping job specifying niche and location; the system handles job creation, execution via Modal, and updates job status via webhook.",
    "User monitors scraping job progress and can cancel running scrape jobs as needed.",
    "Leads from scraping are populated into user's lead list in the database, filtered by user_id for access control.",
    "The user composes outreach emails and sends them using connected Gmail or Resend account, observing rate limits and handling token refresh automatically.",
    "For voice outreach, users generate Twilio tokens for browser calls, receive call status updates, and listen to recording callbacks updating call records.",
    "Subscription management and billing events are handled automatically via Stripe webhooks, updating user access accordingly.",
    "Users can submit a URL to extract business information using AI for lead enrichment, subject to rate limits and monthly caps.",
    "All interactions are verified with token authentication, signature validations on webhooks, and encrypted sensitive data storage to protect user data."
  ],
  "validation_criteria": [
    "Endpoints require valid JWT tokens for authentication and reject unauthorized requests with 401 errors.",
    "Webhooks from Twilio and Stripe verify signatures before processing, returning 403 or 401 on failure.",
    "Lead scraping jobs correctly start, update status from callbacks, and can be cancelled only by job owners.",
    "Gmail OAuth flow exchanges codes correctly and stores encrypted tokens; errors handled with appropriate responses.",
    "Twilio multi-step verification process validates inputs and saves credentials only when successful.",
    "Emails sent respect rate limits (50 per minute) and handle token expiry automatically.",
    "Scraping from URLs is limited to 20 per minute and monthly free user limits, with proper error returns on exceeding limits.",
    "Call status, voice webhook, and recording ready callbacks accurately update call records in the database.",
    "Stripe webhook events handle subscription lifecycle changes securely and update user entitlements.",
    "All sensitive credentials are securely encrypted before storage and decrypted as needed.",
    "API requests with missing or invalid fields return 400 errors with meaningful messages.",
    "CORS is configured to allow only authorized origins to access endpoints.",
    "Performance and scalability meet requirements supporting hundreds of concurrent users and thousands of leads."
  ],
  "code_summary": {
